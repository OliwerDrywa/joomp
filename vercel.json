{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/x",
      "destination": "/x.html"
    },
    {
      "source": "/ac",
      "destination": "/api/suggest"
    },
    {
      "source": "/((?!api/|_next/|favicon.ico|x\\.html|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
